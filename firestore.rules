rules_version = '2';
// Firebase 콘솔(llove-djsdj → Firestore → 규칙)에 게시된 규칙을 2026-08-26 그대로 옮겨 옴.
// 코드가 실제로 쓰는 경로는 users/{uid} 및 그 서브컬렉션(예: 토큰로그) 뿐.
// 본인 문서만 읽기·쓰기 가능 — 콘솔에서 바꿀 때 이 파일도 함께 갱신할 것.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      // 루트 문서 필드 수 상한 — 앱이 실제로 쓰는 필드는 70개 안팎(2026-11-07 grep). 임의 필드 무한 추가 차단.
      // 문서 크기는 Firestore 자체 상한(1MiB)이 막는다. 서브컬렉션은 기존대로 둔다(보수적).
      allow create, update: if request.auth != null && request.auth.uid == userId
                            && request.resource.data.size() <= 200;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
