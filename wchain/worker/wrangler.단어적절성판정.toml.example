# Cloudflare Workers 배포 설정 예시 — 실제로 쓰려면 파일명을 wrangler.toml로 바꾸고
# (이 폴더에서 wrangler.toml은 .gitignore로 막혀 있지 않으니, 인증키를 여기 적지 말 것 —
#  키는 반드시 `wrangler secret put <제공사 키이름>` 또는 대시보드 Variables에서 등록.
#  대시보드에서 코드만 붙여넣어 배포한다면 이 파일은 필요 없다 — 참고용.)

# 이름은 Llove 쪽 js/grok.js의 GROK_WORKERS_ENDPOINT(xai-api-llove)와 일부러 다르게 뒀다 —
# 이 Worker는 "이의있음" 전용 단일 목적(적절성 판정)이고, xai-api-llove는 문제생성·질문하기·
# 구어교정 등 Llove 전 기능 공용으로 계획된 별도 계약(기능명+payload)이라 이름이 겹치면 안 된다.
name = "itneun-word-appropriateness"
main = "단어적절성판정-worker.mjs"
compatibility_date = "2026-07-01"

# 인증키는 여기 적지 않는다. 배포 후 아래 명령으로 등록:
#   npx wrangler secret put ANTHROPIC_API_KEY   # 1차 판정 (claude-haiku-4-5)
#   npx wrangler secret put OPENAI_API_KEY      # 2차 교차검증 (gpt-5.4-mini)
#   — 2026-08-27 확정 조합이 두 회사라 키가 2개 필요하다. 모델을 바꾸면 worker 파일의
#     제공사표·단어적절성판정-README.md 표를 보고 해당 제공사 키로 교체할 것.
